# ============================================================
# Game Support Agent 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ============================================================

# === 基础配置 ===
APP_NAME=game-support-agent
APP_VERSION=1.0.0
DEBUG=false

# API服务配置
HOST=0.0.0.0
PORT=8002

# === LLM 配置 ===
# OpenAI API（或兼容的API，如Azure、第三方代理）
OPENAI_API_KEY=sk-your-api-key-here
MODEL_NAME=gpt-3.5-turbo
# LLM_BASE_URL=https://api.openai.com/v1  # 如果使用第三方API代理

# === 外部服务配置 ===
# RAG服务（enterprise-rag项目）
RAG_SERVICE_URL=http://localhost:8000

# MCP服务器
MCP_SERVER_URL=http://localhost:8001
MCP_API_KEY=your-mcp-api-key-here

# === Human-in-loop 配置 ===
# 是否启用人工审核
HIL_ENABLED=true

# 置信度阈值（0-1），低于此值触发审核
HIL_CONFIDENCE_THRESHOLD=0.6

# 敏感词列表（逗号分隔）
SENSITIVE_WORDS=封号,退款,投诉,举报,盗号,外挂,作弊,违规,起诉,律师,12315,消协,法院

# === 安全配置 ===
# FastAPI层API Key（用于保护API端点）
API_KEY=your-fastapi-api-key-here

# === 日志配置 ===
LOG_LEVEL=INFO
LOG_DIR=./logs

# === 数据库配置（生产环境）===
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/game_support
# REDIS_URL=redis://localhost:6379/0

# === 监控配置（可选）===
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# PROMETHEUS_PORT=9090

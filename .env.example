# ============================================================
# Game Support Agent 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ============================================================

# === 基础配置 ===
APP_NAME=game-support-agent
APP_VERSION=1.0.0
DEBUG=false

# API服务配置
HOST=0.0.0.0
PORT=8002

# === LLM 配置 ===
# 双通道：阿里云优先，OpenAI兜底
DASHSCOPE_API_KEY=your-dashscope-api-key-here
OPENAI_API_KEY=sk-your-openai-api-key-here
REASONING_MODEL_NAME=qwen3.5-plus
# generate 润色节点用的轻量模型，可用 qwen-turbo / qwen3.6-flash 等低成本模型
GENERATE_MODEL_NAME=qwen-turbo
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# === 外部服务配置 ===
# RAG服务（enterprise-rag项目）
RAG_SERVICE_URL=http://localhost:8000

# === Human-in-loop 配置 ===
# 是否启用人工审核
HIL_ENABLED=true

# === 安全配置 ===
# FastAPI层API Key（用于保护API端点）
API_KEY=your-fastapi-api-key-here
# 审核员 API Key（人工审核接口鉴权，请求头 X-Reviewer-Token）
# 简化版，生产应替换为 JWT + RBAC
REVIEWER_API_KEY=your-reviewer-api-key-here

# 游戏 JWT 鉴权（与游戏服共享密钥，客服 API 用 deps.py 验签）
# 本地测试：python scripts/generate_game_token.py --user-id 10001
GAME_JWT_SECRET=your-game-jwt-secret-change-me
GAME_JWT_ALGORITHM=HS256

# === MySQL（Mock 游戏用户 + 工单，docker compose up mysql 自动初始化）===
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=game_support
MYSQL_PASSWORD=game_support_pass
MYSQL_DATABASE=game_support

# === 日志配置 ===
LOG_LEVEL=INFO
LOG_DIR=./logs

# === Redis 配置（生产环境） ===
# pending_store 使用 Redis 实现持久化，重启不丢失
# 如果 Redis 不可用，自动降级为内存 dict（重启丢失）
REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=your-redis-password

# === SQLite 数据库 ===
# Agent 状态检查点和工单数据
DB_PATH=./data/game_support.db

# === LangSmith 可观测性（可选）===
# 开启后在 LangSmith 后台可视化查看 LangGraph 完整执行链路
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls_xxxxxxxx
LANGCHAIN_PROJECT=game-support-agent

# === 监控配置（可选）===
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# PROMETHEUS_PORT=9090

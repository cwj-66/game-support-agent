# ============================================================
# Game Support Agent 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ============================================================

# === 基础配置 ===
APP_NAME=game-support-agent
APP_VERSION=1.0.0
DEBUG=false

# API 服务配置
HOST=0.0.0.0
PORT=8002

# === LLM 配置 ===
# 双通道：阿里云优先，OpenAI 兜底
DASHSCOPE_API_KEY=your-dashscope-api-key-here
OPENAI_API_KEY=sk-your-openai-api-key-here
REASONING_MODEL_NAME=qwen3.5-plus
# generate 润色节点用的轻量模型
GENERATE_MODEL_NAME=qwen-turbo
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# === 外部服务配置 ===
# 真实 RAG：需实现 POST /api/v1/retrieve，见 README
# docker compose up 会在同一网络起 rag-api，容器内自动用 http://rag-api:8000
# 仅本机 uvicorn / mock 时才用下面的 localhost
RAG_SERVICE_URL=http://localhost:8000
RAG_API_KEY=dev-rag-key
# 两个仓库同级时无需修改；RAG 在别处时填绝对路径（正斜杠）
# ENTERPRISE_RAG_DIR=D:/PythonProject/enterprise-rag
# 前端宿主机端口，VPS 可设 FRONTEND_PORT=80
# FRONTEND_PORT=5175

# === 安全配置 ===
# 审核员 API Key（人工接待接口鉴权，请求头 X-Reviewer-Token）
# 本地演示可设为 dev；前端客服工作台默认发送同样的 token
REVIEWER_API_KEY=dev
# 游戏 JWT 鉴权（与游戏服共享密钥）
# 本地测试：python scripts/generate_game_token.py --user-id 10001
# 或设 DEBUG=true 且不填 GAME_JWT_SECRET，跳过玩家鉴权
GAME_JWT_SECRET=your-game-jwt-secret-change-me
GAME_JWT_ALGORITHM=HS256

# === MySQL（docker compose up -d mysql 自动初始化）===
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=game_support
MYSQL_PASSWORD=game_support_pass
MYSQL_DATABASE=game_support

# === 日志 ===
LOG_LEVEL=INFO

# === Redis（待接待队列；Agent 状态不走 Redis）===
# Docker Compose 宿主机映射为 6380，容器内仍用 redis:6379
REDIS_URL=redis://localhost:6380/0

# === SQLite（LangGraph Agent 状态检查点）===
DB_PATH=./data/game_support.db

# === LangSmith 可观测性（可选）===
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls_xxxxxxxx
LANGCHAIN_PROJECT=game-support-agent
